{
    "name": "ingco/meeting-ai",
    "type": "project",
    "description": "Mobile-first automated meeting minutes for INGCO Indonesia",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "3.1.6",
        "google/apiclient": "^2.16",
        "laravel/framework": "^10.48",
        "phpoffice/phpword": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}
    },
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "post-create-project-cmd": ["@php artisan key:generate --ansi"]
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
