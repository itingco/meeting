APP_NAME="INGCO Meeting AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Pilih sqlite (local mudah) atau pgsql (production/standar perusahaan)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=meeting_ai
# DB_USERNAME=postgres
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Kunci API hanya di .env, JANGAN commit
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# Demo true untuk uji alur tanpa panggil AI sungguhan (bukan transkripsi nyata)
MEETING_DEMO_AI=false

# Perlu FFmpeg tersedia dalam PATH atau isi path executable
FFMPEG_BINARY=ffmpeg

# Set false sampai OAuth Drive berhasil terhubung
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_PARENT_ID=1-J92rqZP8K-VmY-XHVL73YhAJYC7CZG0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/settings/google/callback

# SMTP screenshot server; masukkan password via .env sendiri
MAIL_MAILER=smtp
MAIL_HOST=srv179.niagahoster.com
MAIL_PORT=465
MAIL_USERNAME=ai@ingco.co.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=ai@ingco.co.id
MAIL_FROM_NAME="INGCO Meeting AI"
MEETING_MAIL_ENABLED=false
MEETING_INITIAL_RECIPIENT=antoni@ingco.co.id
# Daftar departemen disiapkan namun TIDAK dipakai sampai diaktifkan secara sadar
MEETING_RECIPIENT_ROUTING_ENABLED=false
